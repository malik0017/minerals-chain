[Unit]
Description=Minerals Chain scheduled jobs
After=network.target postgresql.service

[Service]
Type=oneshot
User=minerals
Group=minerals
WorkingDirectory=/srv/minerals/app
EnvironmentFile=/srv/minerals/app/.env
ExecStart=/srv/minerals/venv/bin/python scripts/run_scheduled_jobs.py --due
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/srv/minerals/app/storage /var/backups/minerals-chain

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://mineralschain.sa
FORWARDED_ALLOW_IPS=127.0.0.1

DATABASE_URL=postgresql://minerals:CHANGE_ME@127.0.0.1:5432/minerals_chain
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY=GENERATE_WITH_scripts/harden_env.py
FILE_ENCRYPTION_KEY=GENERATE_WITH_scripts/harden_env.py
COOKIE_SECURE=true
CSP_MODE=enforce

EMAIL_MODE=smtp
SMTP_HOST=smtp.your-provider.sa
SMTP_PORT=587
SMTP_USERNAME=no-reply@mineralschain.sa
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@mineralschain.sa
SMTP_FROM_NAME="Minerals Chain"

BACKUP_DIR=/var/backups/minerals-chain
BACKUP_KEEP=30
PG_BIN_DIR=

WATHQ_MODE=live
WATHQ_API_KEY=
WATHQ_BASE_URL=https://api.wathq.sa/v5/commercialregistration
MIM_MODE=sandbox
MIM_API_URL=
MIM_API_KEY=
